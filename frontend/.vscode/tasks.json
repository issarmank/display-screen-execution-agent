{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "swift: build",
      "type": "shell",
      "command": "swift build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$swiftc"]
    },
    {
      "label": "swift: test",
      "type": "shell",
      "command": "swift test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$swiftc"]
    },
    {
      "label": "app: bundle",
      "type": "shell",
      "command": "scripts/bundle.sh",
      "problemMatcher": ["$swiftc"]
    },
    {
      "label": "app: run (.app, mic enabled)",
      "type": "shell",
      "command": "scripts/run.sh",
      "problemMatcher": ["$swiftc"]
    }
  ]
}
